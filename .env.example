# 教员AI顾问 - 环境配置模板
# 复制此文件为 .env 并修改为你需要的配置

# Ollama 服务地址
OLLAMA_HOST=http://localhost:11434

# LLM 模型名称
# Mac M5 24GB 推荐: qwen3:30b-a3b (30B MoE, 约3.3B active参数, 需约8GB VRAM)
# 低配机器可选: qwen3:8b
MODEL_NAME=qwen3:30b-a3b

# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# 日志级别
LOG_LEVEL=INFO

# 思考模式（启用 Qwen3 的 thinking 标签）
ENABLE_THINKING=true

# LLM 超时时间（秒）
LLM_TIMEOUT=60

# 最大对话轮次
MAX_FULL_TURNS=10

# CORS 来源（前端开发服务器）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
