# 教员AI顾问 v3.0 - 环境配置
# 24GB MacBook 专属优化配置

# ========================
# 模型配置（24GB推荐）
# ========================

# 首选: qwen3:30b-a3b (30B参数MoE，仅激活3.3B，内存~8GB，质量最佳)
# 备选: qwen3:14b (14.8B参数，内存~10GB)
# 保底: qwen3:8b (8.2B参数，内存~6GB，速度最快)
MODEL_NAME=qwen3:30b-a3b

# Ollama服务地址
OLLAMA_HOST=http://localhost:11434

# ========================
# 性能配置
# ========================

# 启用Thinking模式（Qwen3特性，推理质量大幅提升）
ENABLE_THINKING_MODE=true

# LLM超时时间（秒）
LLM_TIMEOUT_SECONDS=60

# 最大上下文长度
MAX_CONTEXT_TOKENS=16384

# 温度（0.5=更确定，0.7=平衡，0.9=更有创意）
DEFAULT_TEMPERATURE=0.7

# Top-P采样
DEFAULT_TOP_P=0.95

# ========================
# 知识库配置
# ========================

# 认知图谱数据目录
COGNITIVE_GRAPH_DIR=data/cognitive_graph

# 毛选向量库目录
MAOXUAN_DB_DIR=data/maoxuan/chroma_db

# 检索返回段落数
MAOXUAN_TOP_K=5

# ========================
# 记忆层配置
# ========================

# 用户画像存储目录
PROFILES_DIR=data/profiles

# 最大保留对话轮数
MAX_FULL_TURNS=20

# ========================
# 表达层配置
# ========================

# 回复长度控制
RESPONSE_MIN_LENGTH=100
RESPONSE_MAX_LENGTH=800

# 目标句长（教员风格：20字以内）
TARGET_SENTENCE_LENGTH=20

# 最大苏格拉底提问数
MAX_SOCRATIC_QUESTIONS=5

# ========================
# 日志配置
# ========================

# 日志级别: DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO

# ========================
# API服务配置
# ========================

# 服务端口
API_PORT=8000

# 启用流式输出
ENABLE_STREAMING=true
